# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database URL (Neon PostgreSQL)
# IMPORTANT: Must use postgresql+asyncpg:// for async support
DATABASE_URL=postgresql+asyncpg://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication Secret
# MUST match frontend/.env.local BETTER_AUTH_SECRET
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=change-this-to-a-random-secret-at-least-32-characters-long

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Debug Mode (set to False in production)
DEBUG=True

# OpenAI API Key (Phase 3+)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Logging
LOG_LEVEL=INFO
