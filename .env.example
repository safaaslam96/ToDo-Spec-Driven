# The Evolution of Todo — Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# Phase 2: Full-Stack Web App
# ============================================

# Database (Neon PostgreSQL)
# Get from: https://neon.tech → Project → Connection Details
# IMPORTANT: Change postgresql:// to postgresql+asyncpg:// for async support
DATABASE_URL=postgresql+asyncpg://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication Secret
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Or: openssl rand -base64 32
# MUST BE THE SAME in backend/.env and frontend/.env.local
BETTER_AUTH_SECRET=change-this-to-a-random-secret-at-least-32-characters-long

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Debug Mode (Development only)
DEBUG=True

# ============================================
# Phase 3: AI Chatbot Integration
# ============================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# OpenAI Model Selection
OPENAI_MODEL=gpt-4
# Alternatives: gpt-4-turbo, gpt-3.5-turbo

# ============================================
# Phase 4-5: Cloud Deployment
# ============================================

# DigitalOcean API Token
# Get from: https://cloud.digitalocean.com/account/api/tokens
DO_API_TOKEN=dop_v1_your_digitalocean_token_here

# Docker Registry (if using DigitalOcean Container Registry)
DOCKER_REGISTRY=registry.digitalocean.com/your-registry-name

# Production Database (if switching from Neon)
# DATABASE_URL_PROD=postgresql+asyncpg://user:pass@prod-host/dbname

# Kafka Configuration (Phase 4)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TASK_EVENTS=task-events

# Dapr Configuration (Phase 4)
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001

# ============================================
# Development Tools
# ============================================

# Log Level
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Sentry (Error Tracking - Optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# Testing
# ============================================

# Test Database (use different DB for tests)
TEST_DATABASE_URL=postgresql+asyncpg://username:password@ep-test-123456.us-east-2.aws.neon.tech/testdb?sslmode=require

# ============================================
# IMPORTANT NOTES
# ============================================

# 1. NEVER commit this file with real secrets to Git
# 2. Keep .env in .gitignore
# 3. For production, use environment variables or secret managers (not .env files)
# 4. BETTER_AUTH_SECRET must be the same in backend/.env and frontend/.env.local
# 5. DATABASE_URL must use postgresql+asyncpg:// prefix (not postgresql://)
# 6. Generate strong secrets — minimum 32 characters
