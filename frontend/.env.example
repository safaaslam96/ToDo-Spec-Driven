# Frontend Environment Variables
# Copy this file to .env.local (NOT .env for security)

# Public environment variables (accessible in browser)
# These MUST have NEXT_PUBLIC_ prefix
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Server-side only variables (NOT exposed to browser)
# MUST match backend/.env BETTER_AUTH_SECRET
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=change-this-to-a-random-secret-at-least-32-characters-long

# IMPORTANT NOTES:
# 1. Use .env.local (not .env) — Next.js convention
# 2. .env.local is in .gitignore by default
# 3. Only NEXT_PUBLIC_* variables are exposed to browser
# 4. NEVER put secrets in NEXT_PUBLIC_* variables
# 5. BETTER_AUTH_SECRET must match backend/.env exactly
